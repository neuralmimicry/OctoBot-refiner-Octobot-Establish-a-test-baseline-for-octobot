+"""Candle API contracts: venue isolation, causality, bounded reads and failures."""
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import aiohttp
+import pytest
+
+import octobot.enums
+import tentacles.Services.Interfaces.web_interface.api.market_history as history
+import tentacles.Services.Interfaces.web_interface.tests as web_tests
+import tentacles.Services.Interfaces.web_interface.tests.distribution_tester as distribution_tester
+
+
+def test_history_excludes_unfinished_candle_and_preserves_open_times():
+    rows = [[3600, 10, 12, 9, 11, 5], [7200, 11, 12, 10, 12, 7]]
+    assert history.closed_candles(rows, 3600, 8000, 500) == [rows[0]]
+
+
+@pytest.mark.parametrize("rows", [
+    [], [[3600, 10, 12, 9, 11]], [[3600, 10, float("nan"), 9, 11, 5]],
+    [[3600000000000, 10, 12, 9, 11, 5]], [[3600, 10, 9, 8, 11, 5]],
+    [[3600, 10, 12, 9, 11, -1]],
+    [[3600, 10, 12, 9, 11, 5], [3600, 10, 12, 9, 11, 5]],
+])
+def test_history_rejects_corrupt_data_instead_of_successful_null(rows):
+    with pytest.raises(RuntimeError):
+        history.closed_candles(rows, 3600, 10000, 500)
+
+
+@pytest.mark.parametrize("exchange,symbol,frame,limit", [
+    (None, "BTC/USDT", "1h", "500"), ("binance", None, "1h", "500"),
+    ("binance", "BTC/USDT", "bogus", "500"),
+    ("binance", "BTC/USDT", "1M", "500"),
+    ("binance", "BTC/USDT", "1h", "1001"),
+    ("binance", "BTC/USDT", "1h", "0"),
+    ("binance", "BTC/USDT", "1h", "invalid"),
+])
+def test_invalid_requests_never_resolve_a_venue(exchange, symbol, frame, limit):
+    def resolver(_):
+        pytest.fail("invalid request reached a venue")
+    with pytest.raises(ValueError):
+        history.get_market_candles(exchange, symbol, frame, limit, resolver)
+
+
+def test_history_fetches_native_public_rest_without_activating_pairs(monkeypatch):
+    venue = SimpleNamespace(
+        get_symbol_prices=AsyncMock(return_value=[[3600, 10, 12, 9, 11, 5]]),
+        get_exchange_current_time=lambda: 8000,
+    )
+    manager = SimpleNamespace(exchange=venue)
+    monkeypatch.setattr(history.trading_api, "get_all_exchange_symbols", lambda _: ["BTC/USDT"])
+    monkeypatch.setattr(history.trading_api, "get_exchange_name", lambda _: "bitget")
+    monkeypatch.setattr(history.trading_api, "get_exchange_manager_id", lambda _: "bitget-id")
+    monkeypatch.setattr(history.trading_api, "is_trader_simulated", lambda _: False)
+    monkeypatch.setattr(history.interfaces_util, "run_in_bot_main_loop", lambda coro, **_: asyncio.run(coro))
+    requested = []
+    def resolver(name):
+        requested.append(name)
+        return manager
+    result = history.get_market_candles("bitget", "BTC/USDT", "1h", "500", resolver)
+    assert requested == ["bitget"]
+    assert result["exchange"] == "bitget"
+    assert result["candles"]["time"] == [3600]
+    assert result["candles"]["close"] == [11]
+    assert result["closed_only"] is True
+    venue.get_symbol_prices.assert_awaited_once_with("BTC/USDT", history.commons_enums.TimeFrames.ONE_HOUR, limit=500)
+    with pytest.raises(KeyError):
+        history.get_market_candles("bitget", "UNKNOWN/USDT", "1h", "500", resolver)
+    assert venue.get_symbol_prices.await_count == 1
+
+
+@pytest.mark.asyncio
+async def test_candle_route_requires_normal_web_authentication():
+    async with web_tests.get_web_interface(True, octobot.enums.OctoBotDistribution.DEFAULT) as interface:
+        async with aiohttp.ClientSession() as session:
+            await web_tests.check_page_login_redirect(
+                f"{distribution_tester.LOCAL_HOST_URL}{interface.port}/api/market/candles", session
+            )
+
+
+@pytest.mark.asyncio
+async def test_candle_route_returns_explicit_errors(monkeypatch):
+    async with web_tests.get_web_interface(False, octobot.enums.OctoBotDistribution.DEFAULT) as interface:
+        url = f"{distribution_tester.LOCAL_HOST_URL}{interface.port}/api/market/candles"
+        async with aiohttp.ClientSession() as session:
+            async with session.get(url) as response:
+                assert response.status == 400
+            async with session.get(url + "?exchange=missing-venue&symbol=BTC/USDT") as response:
+                assert response.status == 404
+            def unavailable(*_):
+                raise RuntimeError("private credential must not reach HTTP response")
+            monkeypatch.setattr(history, "get_market_candles", unavailable)
+            async with session.get(url) as response:
+                assert response.status == 503
+                assert "private credential" not in await response.text()
