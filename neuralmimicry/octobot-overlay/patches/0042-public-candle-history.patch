+"""Read-only public candle history, independent of the UI's watched-pair cache.
+
+The venue's native asynchronous REST client runs on OctoBot's event loop. This
+endpoint never activates pairs, changes strategies, or invokes a trader. Native
+adapters supply UTC epoch seconds and OHLCV rows; only closed candles are exposed.
+"""
+import asyncio
+import math
+
+import flask
+
+import octobot_commons.enums as commons_enums
+import octobot_services.interfaces.util as interfaces_util
+import octobot_trading.api as trading_api
+import tentacles.Services.Interfaces.web_interface.login as login
+import tentacles.Services.Interfaces.web_interface.util as util
+
+
+def closed_candles(rows, duration, now, limit):
+    """Reject corrupt/unaligned data; a candle close is observable at its end.
+
+    Do not replace absent observation times with request time. Otherwise stale
+    data appears fresh and backtests can see a candle's close before it occurs.
+    """
+    result = []
+    previous = 0
+    for row in rows or []:
+        if len(row) != 6:
+            raise RuntimeError("Invalid venue OHLCV row length")
+        values = [float(value) for value in row]
+        if not all(math.isfinite(value) for value in values):
+            raise RuntimeError("Non-finite venue OHLCV value")
+        opened, opening, high, low, close, volume = values
+        if (opened <= previous or opened <= 0 or opened > 10_000_000_000
+                or min(opening, high, low, close) <= 0 or volume < 0
+                or low > min(opening, close) or high < max(opening, close)):
+            raise RuntimeError("Invalid venue OHLCV values or timestamp order")
+        previous = opened
+        if opened + duration <= now:
+            result.append(values)
+    if not result:
+        raise RuntimeError("Venue returned no valid closed candles")
+    return result[-limit:]
+
+
+def get_market_candles(exchange, symbol, time_frame, limit, resolver):
+    """Resolve an explicit venue and fetch at most 1000 public candles."""
+    if not exchange or not exchange.strip():
+        raise ValueError("exchange is required")
+    if not symbol or not symbol.strip():
+        raise ValueError("symbol is required")
+    symbol = symbol.strip().replace("|", "/").upper()
+    frame = commons_enums.TimeFrames(time_frame)
+    # Calendar periods cannot use a fixed close-time offset.
+    if frame in (commons_enums.TimeFrames.ONE_MONTH, commons_enums.TimeFrames.ONE_YEAR):
+        raise ValueError("Calendar time frames are not supported")
+    limit = int(limit)
+    if not 2 <= limit <= 1000:
+        raise ValueError("limit must be between 2 and 1000")
+    manager = resolver(exchange)
+    if symbol not in trading_api.get_all_exchange_symbols(manager):
+        raise KeyError(f"Symbol is not listed on {exchange}: {symbol}")
+
+    async def fetch():
+        return await asyncio.wait_for(
+            manager.exchange.get_symbol_prices(symbol, frame, limit=limit), timeout=30
+        )
+
+    rows = interfaces_util.run_in_bot_main_loop(fetch(), timeout=35)
+    now = manager.exchange.get_exchange_current_time()
+    duration = commons_enums.TimeFramesMinutes[frame] * 60
+    rows = closed_candles(rows, duration, now, limit)
+    return {
+        "exchange": trading_api.get_exchange_name(manager),
+        "exchange_id": trading_api.get_exchange_manager_id(manager),
+        "symbol": symbol,
+        "time_frame": frame.value,
+        "source": "venue_rest",
+        "simulated": trading_api.is_trader_simulated(manager),
+        "timestamp_unit": "seconds",
+        "timestamp_semantics": "candle_open",
+        "closed_only": True,
+        "candles": dict(zip(
+            ("time", "open", "high", "low", "close", "volume"),
+            map(list, zip(*rows)),
+        )),
+    }
+
+
+def register(blueprint, resolver):
+    """Share trading's venue resolver and normal API authentication boundary."""
+    @blueprint.route("/market/candles", methods=["GET"])
+    @login.login_required_when_activated
+    def market_candles():
+        try:
+            return flask.jsonify(get_market_candles(
+                flask.request.args.get("exchange"),
+                flask.request.args.get("symbol"),
+                flask.request.args.get("time_frame", "1h"),
+                flask.request.args.get("limit", "500"),
+                resolver,
+            ))
+        except ValueError as err:
+            return util.get_rest_reply(str(err), 400)
+        except KeyError as err:
+            return util.get_rest_reply(str(err), 404)
+        except Exception:
+            # Exception bodies may include exchange credentials or network details.
+            # The API contract remains explicit, never HTTP 200 plus JSON null.
+            return util.get_rest_reply("Venue candle history unavailable", 503)
