+#  NeuralMimicry overlay tests for the Gail compatibility API routes.
+#
+#  This library is free software; you can redistribute it and/or
+#  modify it under the terms of the GNU Lesser General Public
+#  License as published by the Free Software Foundation; either
+#  version 3.0 of the License, or (at your option) any later version.
+import json
+
+import pytest
+
+import octobot.enums
+import tentacles.Services.Interfaces.web_interface.tests as web_interface_tests
+import tentacles.Services.Interfaces.web_interface.tests.models.distributions.distribution_tester as distribution_tester
+
+
+pytestmark = pytest.mark.asyncio
+
+DISTRIBUTION = octobot.enums.OctoBotDistribution.DEFAULT
+GAIL_GET_ROUTES = ("/api/market/ticker", "/api/exchanges", "/api/portfolio", "/api/logs", "/api/orders")
+
+
+def _url(web_interface_instance, path):
+    return f"{distribution_tester.LOCAL_HOST_URL}{web_interface_instance.port}{path}"
+
+
+async def test_gail_routes_are_registered_on_the_api_blueprint():
+    async with web_interface_tests.get_web_interface(False, DISTRIBUTION) as web_interface_instance:
+        rules = {
+            rule.rule: rule
+            for rule in web_interface_instance.server_instance.url_map.iter_rules()
+        }
+        for route in GAIL_GET_ROUTES:
+            assert route in rules, route
+            assert "GET" in rules[route].methods, route
+            assert rules[route].endpoint.startswith("api."), (route, rules[route].endpoint)
+        assert "POST" in rules["/api/orders"].methods
+
+
+async def test_market_ticker_requires_login_when_password_is_required():
+    async with web_interface_tests.get_web_interface(True, DISTRIBUTION) as web_interface_instance:
+        async with distribution_tester._distribution_test_client_session() as session:
+            await web_interface_tests.check_page_login_redirect(
+                _url(web_interface_instance, "/api/market/ticker"), session
+            )
+
+
+async def test_market_ticker_rejects_missing_symbol_with_404():
+    async with web_interface_tests.get_web_interface(False, DISTRIBUTION) as web_interface_instance:
+        async with distribution_tester._distribution_test_client_session() as session:
+            async with session.get(_url(web_interface_instance, "/api/market/ticker")) as resp:
+                assert resp.status == 404
+                assert "symbol is required" in await resp.text()
+
+
+async def test_market_ticker_rejects_unknown_exchange_with_404():
+    async with web_interface_tests.get_web_interface(False, DISTRIBUTION) as web_interface_instance:
+        async with distribution_tester._distribution_test_client_session() as session:
+            url = _url(web_interface_instance, "/api/market/ticker?symbol=BTC/USDT&exchange=not-an-exchange")
+            async with session.get(url) as resp:
+                assert resp.status == 404
+                assert "No exchange to be found: not-an-exchange" in await resp.text()
+
+
+async def test_exchanges_inventory_is_a_json_list():
+    async with web_interface_tests.get_web_interface(False, DISTRIBUTION) as web_interface_instance:
+        async with distribution_tester._distribution_test_client_session() as session:
+            async with session.get(_url(web_interface_instance, "/api/exchanges")) as resp:
+                assert resp.status == 200
+                inventory = json.loads(await resp.text())
+                assert isinstance(inventory, list)
+                for entry in inventory:
+                    assert {"name", "exchange", "id", "exchange_id", "enabled", "trading", "symbols"} <= set(entry)
