+import os
+
+# NeuralMimicry overlay: fetch_and_extract_tentacles resolves relative temp dirs
+# under $OCTOBOT_TENTACLES_TEMP_ROOT (default /tmp). These tests use temp dirs
+# relative to the working directory, so resolve them there.
+os.environ.setdefault("OCTOBOT_TENTACLES_TEMP_ROOT", os.curdir)
+
 import pytest
 import mock
 import octobot_tentacles_manager.constants as constants
