@@ -233,11 +233,36 @@ Remember:
         Returns:
             Merged state dict with signal_synthesis and risk_output at top level.
         """
-        
+
         try:
-            return dict(input_data)
+            state = dict(input_data)
         except Exception:
             return {}
+
+        if state.get("signal_synthesis") is not None or state.get("risk_output") is not None:
+            return state
+
+        def _extract_candidate(payload: typing.Any) -> typing.Optional[typing.Dict[str, typing.Any]]:
+            if not isinstance(payload, dict):
+                return None
+            if isinstance(payload.get(agent_constants.RESULT_KEY), dict):
+                return payload.get(agent_constants.RESULT_KEY)
+            if isinstance(payload.get("result"), dict):
+                return payload.get("result")
+            return payload
+
+        for payload in list(state.values()):
+            candidate = _extract_candidate(payload)
+            if not isinstance(candidate, dict):
+                continue
+            if state.get("signal_outputs") is None and candidate.get("signal_outputs") is not None:
+                state["signal_outputs"] = candidate.get("signal_outputs")
+            if state.get("signal_synthesis") is None and candidate.get("signal_synthesis") is not None:
+                state["signal_synthesis"] = candidate.get("signal_synthesis")
+            if state.get("risk_output") is None and candidate.get("risk_output") is not None:
+                state["risk_output"] = candidate.get("risk_output")
+
+        return state
     
