+                debate_config = dict(debate_config)
+                if not isinstance(debate_config.get("debator_agent_names"), list) or not debate_config.get("debator_agent_names"):
+                    debate_config["debator_agent_names"] = ["BullResearchAIAgentProducer", "BearResearchAIAgentProducer"]
+                if not isinstance(debate_config.get("judge_agent_name"), str) or not debate_config.get("judge_agent_name"):
+                    debate_config["judge_agent_name"] = "RiskJudgeAIAgentProducer"
+                if not isinstance(debate_config.get("max_rounds"), int) or debate_config.get("max_rounds", 0) < 1:
+                    debate_config["max_rounds"] = 3
+                step["debate_config"] = debate_config
+
+            if step.get("debate_config") and step_type in (None, "agent"):
+                step["step_type"] = "debate"
+                step.setdefault("agent_name", "debate")
+                repaired_steps.append(step)
                 continue
+
+            agent_name = step.get("agent_name") or step.get("name") or step.get("agent")
+            if step_type in (None, "agent"):
+                if not agent_name:
+                    agent_name = fallback_agent_name
+                elif allowed and agent_name not in allowed:
+                    normalized = allowed_map.get(str(agent_name).lower())
+                    if normalized is None:
+                        import difflib
+                        matches = difflib.get_close_matches(str(agent_name).lower(), allowed_map.keys(), n=1, cutoff=0.6)
+                        normalized = allowed_map[matches[0]] if matches else fallback_agent_name
+                    agent_name = normalized
+                if not agent_name:
+                    continue
+                step["agent_name"] = agent_name
             repaired_steps.append(step)
+
+        if not repaired_steps and fallback_agent_name:
+            repaired_steps.append({"step_type": "agent", "agent_name": fallback_agent_name})
+
         if not repaired_steps:
             return None
+
         repaired = {**response_data, "steps": repaired_steps}
