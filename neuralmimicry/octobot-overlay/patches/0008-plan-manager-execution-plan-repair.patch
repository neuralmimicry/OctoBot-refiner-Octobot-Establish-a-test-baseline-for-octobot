+                    parsed = None
+                if isinstance(parsed, dict):
+                    response_data = parsed
+
         if not isinstance(response_data, dict):
             return None
+
+        allowed_agent_names = allowed_agent_names or []
+        allowed = set(allowed_agent_names)
+        allowed_map = {name.lower(): name for name in allowed_agent_names}
+        fallback_agent_name = allowed_agent_names[0] if allowed_agent_names else None
+
         steps = response_data.get("steps")
         if not isinstance(steps, list):
-            return None
+            steps = []
+
         repaired_steps = []
         for step in steps:
             if not isinstance(step, dict):
                 continue
+            step = dict(step)
             step_type = step.get("step_type")
