+#  version 3.0 of the License, or (at your option) any later version.
+import unittest.mock as mock
+
+import aiohttp
+import octobot.enums
+import pytest
+
+import tentacles.Services.Interfaces.web_interface.models as web_interface_models
+import tentacles.Services.Interfaces.web_interface.tests as web_interface_tests
+
+
+pytestmark = pytest.mark.asyncio
+
+DISTRIBUTION = octobot.enums.OctoBotDistribution.DEFAULT
+
+
+async def test_backtesting_get_returns_data_files():
+    with mock.patch.object(web_interface_models, "is_backtesting_enabled", return_value=True), \
+            mock.patch.object(web_interface_models, "get_data_files_with_description", return_value=[]):
+        async with web_interface_tests.get_web_interface(False, DISTRIBUTION) as interface:
+            async with aiohttp.ClientSession() as session:
+                url = f"http://localhost:{interface.port}/backtesting?update_type=backtesting_data_files"
+                async with session.get(url, allow_redirects=False) as response:
+                    assert response.status == 200
+                    assert await response.json() == {"files": [], "source": "backtesting"}
+
+
+async def test_backtesting_get_rejects_unsupported_query_without_server_error():
+    with mock.patch.object(web_interface_models, "is_backtesting_enabled", return_value=True):
+        async with web_interface_tests.get_web_interface(False, DISTRIBUTION) as interface:
+            async with aiohttp.ClientSession() as session:
+                url = f"http://localhost:{interface.port}/backtesting?unexpected=1"
+                async with session.get(url, allow_redirects=False) as response:
+                    assert response.status == 400
+
+
+async def test_backtesting_get_rejects_missing_report_source():
+    with mock.patch.object(web_interface_models, "is_backtesting_enabled", return_value=True):
+        async with web_interface_tests.get_web_interface(False, DISTRIBUTION) as interface:
+            async with aiohttp.ClientSession() as session:
+                url = f"http://localhost:{interface.port}/backtesting?update_type=backtesting_report"
+                async with session.get(url, allow_redirects=False) as response:
+                    assert response.status == 400
+
+
+async def test_backtesting_post_rejects_unsupported_action_without_server_error():
+    with mock.patch.object(web_interface_models, "is_backtesting_enabled", return_value=True):
+        async with web_interface_tests.get_web_interface(False, DISTRIBUTION) as interface:
+            async with aiohttp.ClientSession() as session:
+                url = f"http://localhost:{interface.port}/backtesting?action_type=unsupported"
+                async with session.post(url, json={}, allow_redirects=False) as response:
+                    assert response.status == 400
