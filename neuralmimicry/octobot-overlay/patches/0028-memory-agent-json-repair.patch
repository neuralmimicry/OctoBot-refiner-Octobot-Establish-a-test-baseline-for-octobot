+import ast
+import json
 import typing
 
 import octobot_agents.agent.memory as memory
@@ -122,6 +124,50 @@ Only process memories for agents listed in critic_analysis.agent_improvements.
 For each such agent, produce a small set of concise, high-impact behavioral or strategic
 instructions that would have helped avoid the issues or replicate the successes."""
     
+    @staticmethod
+    def _extract_json_object(content: typing.Any) -> typing.Optional[typing.Dict[str, typing.Any]]:
+        if not isinstance(content, str):
+            return None
+        start = content.find("{")
+        end = content.rfind("}")
+        if start == -1 or end <= start:
+            return None
+        candidate = content[start:end + 1].strip()
+        for parser in (json.loads, ast.literal_eval):
+            try:
+                parsed = parser(candidate)
+            except Exception:
+                continue
+            if isinstance(parsed, dict):
+                return parsed
+        return None
+
+    def _coerce_instructions_payload(
+        self,
+        response_data: typing.Any,
+    ) -> typing.Dict[str, typing.Any]:
+        if isinstance(response_data, dict) and isinstance(response_data.get("instructions"), list):
+            return response_data
+
+        parsed = None
+        if isinstance(response_data, dict) and isinstance(response_data.get("error"), str):
+            parsed = self._extract_json_object(response_data["error"])
+        elif isinstance(response_data, str):
+            parsed = self._extract_json_object(response_data)
+
+        if isinstance(parsed, dict):
+            if isinstance(parsed.get("instructions"), list):
+                return parsed
+            self.logger.warning(
+                "DefaultAIMemoryAgentProducer recovered JSON payload without instructions list; treating as no-op"
+            )
+            return {"instructions": []}
+
+        self.logger.warning(
+            "DefaultAIMemoryAgentProducer received malformed JSON payload; treating memory update as no-op"
+        )
+        return {"instructions": []}
+
     async def execute(
         self,
         input_data: typing.Union[agent_models.MemoryInput, typing.Dict[str, typing.Any]],
@@ -226,6 +272,7 @@ have at least one behavioral or strategic issue to learn from.""",
                 input_data=input_data,
             )
             
